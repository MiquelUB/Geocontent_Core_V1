# ============================================================
# 🛡️ PXX V2 SOVEREIGN — CONFIGURACIÓ DE PRODUCCIÓ
# ============================================================

# --- DATABASE (Postgres + PostGIS) ---
# DATABASE_URL: Accés via PgBouncer (mode transacció)
# DATABASE_DIRECT_URL: Accés directe per a migracions Alembic/Prisma
DATABASE_URL="postgresql://user:pass@host:5432/db?pgbouncer=true"
DATABASE_DIRECT_URL="postgresql://user:pass@host:5432/db"

# --- AUTHENTICATION (Auth.js v5) ---
AUTH_SECRET="generar-amb-openssl-rand-base64-32"
# URL base de l'aplicació per a redireccions d'autenticació
NEXTAUTH_URL="https://app.projectexinoxano.com"
AUTH_TRUST_HOST="true"
# Per a la protecció CORS dinàmica del proxy d'imatges
NEXT_PUBLIC_APP_URL="https://app.projectexinoxano.com"
# Enviament de Magic Links
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# --- INFRASTRUCTURE ---
# Redis per a Rate Limiting i Cues asíncrones (ARQ)
REDIS_URL="redis://:password@redis-host:6379/0"
NODE_ENV="production"

# --- AI ENGINE (OpenRouter) ---
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxx"
# Model per a anàlisi de documents i generació de contingut complex
AI_MODEL_ID="moonshotai/kimi-k2"
# Model per a traduccions (ca→es/en/fr). Gemini té suport natiu de Català.
AI_MODEL_TRANSLATE_ID="google/gemini-2.0-flash-001"

# --- SOVEREIGN STORAGE (S3/MinIO/R2) ---
S3_ENDPOINT="https://s3.host.com"
S3_REGION="auto"
S3_BUCKET="geocontent-v2"
S3_ACCESS_KEY="xxxxxxxx"
S3_SECRET_KEY="xxxxxxxx"
# URL pública per servir imatges (Pot ser via proxy o directa)
NEXT_PUBLIC_STORAGE_URL="https://app.projectexinoxano.com/api/img-proxy?url=..."

# --- BACKEND HÍBRID (Python FastAPI) ---
# URL on corre el backend Python per a comunicació Server-to-Server
BACKEND_INTERNAL_URL="http://backend-python:8000"
# URL del frontend per a CORS del backend
FRONTEND_URL="https://app.projectexinoxano.com"

# --- ADMIN PROVISIONING ---
# Email de l'administrador inicial (Usat pel script scripts/create-admin.ts)
INITIAL_ADMIN_EMAIL="admin@projectexinoxano.com"
