generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis(version: "3"), uuid_ossp(map: "uuid-ossp")]
}

// --- MODELS D'USUARI I AUTH ---

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  emailVerified   DateTime? @map("email_verified")
  password        String?
  username        String?
  image           String?   // Camp estàndard d'Auth.js
  avatarUrl       String?   @map("avatar_url")
  role            UserRole  @default(tourist)
  xp              Int       @default(0)
  level           Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  municipalityId  String?   @map("municipality_id") @db.Uuid
  municipality    Municipality? @relation(fields: [municipalityId], references: [id])
  
  unlocks         UserUnlock[]
  routeProgress   UserRouteProgress[]
  telemetry       UserTelemetry[]
  accounts        Account[]
  sessions        Session[]

  @@map("users")
}

model Account {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String  @map("user_id") @db.Uuid
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}


// --- MODELS DE NEGOCI ---

model Municipality {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  slug                String    @unique
  nameTranslations    Json      @default("{}") @map("name_translations")
  logoUrl             String?   @map("logo_url")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  planTier            String    @default("basic") @map("plan_tier")
  themeId             String?   @default("mountain") @map("theme_id")
  adminMasterPassword String?   @map("admin_master_password")
  
  lastPublishedAt     DateTime? @map("last_published_at")
  packagingStatus     String    @default("IDLE") @map("packaging_status")
  
  routes              Route[]
  users               User[]
  reports             Report[]

  @@map("municipalities")
}

model Route {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId          String?             @map("municipality_id") @db.Uuid
  slug                    String              @unique
  name                    String?
  nameTranslations        Json                @default("{}") @map("name_translations")
  description             String?
  descriptionTranslations Json                @default("{}") @map("description_translations")
  themeId                 ThemeId             @default(mountain) @map("theme_id")
  availabilityType        RouteAvailability   @default(permanent) @map("availability_type")
  isPremium               Boolean             @default(false) @map("is_premium")
  thumbnail1x1            String?             @map("thumbnail_1x1")
  status                  RouteStatus         @default(DRAFT)
  finalQuiz               Json?               @map("final_quiz")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at")
  
  municipality            Municipality?       @relation(fields: [municipalityId], references: [id])
  routePois               RoutePoi[]
  userProgress            UserRouteProgress[]

  @@map("routes")
}

model Poi {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                    String
  description              String?
  titleTranslations        Json         @default("{}") @map("title_translations")
  descriptionTranslations  Json         @default("{}") @map("description_translations")
  
  // Camp PostGIS Natiu (Point, 4326)
  location                 Unsupported("geometry(Point, 4326)")?
  
  audioUrl                 String?      @map("audio_url")
  videoUrls                String[]     @default([]) @map("video_urls")
  textContent              String?      @map("text_content")
  appThumbnail             String?      @map("app_thumbnail")
  header16x9               String?      @map("header_16x9")
  carouselImages           String[]     @default([]) @map("carousel_images")
  icon                     String?
  type                     PoiType?
  manualQuiz               Json?        @map("manual_quiz")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @default(now()) @updatedAt @map("updated_at")
  
  routePois                RoutePoi[]
  userUnlocks              UserUnlock[]
  visits                   PoiVisits[]

  @@index([location], type: Gist)
  @@map("pois")
}

model RoutePoi {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId    String   @map("route_id") @db.Uuid
  poiId      String   @map("poi_id") @db.Uuid
  orderIndex Int      @default(0) @map("order_index")
  
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  poi        Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@unique([routeId, poiId])
  @@map("route_pois")
}

model UserUnlock {
  userId     String   @map("user_id") @db.Uuid
  poiId      String   @map("poi_id") @db.Uuid
  unlockedAt DateTime @default(now()) @map("unlocked_at")
  earnedXp   Int      @map("earned_xp")
  quizSolved Boolean  @default(false) @map("quiz_solved")
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poi        Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@id([userId, poiId])
  @@map("user_unlocks")
}

model UserRouteProgress {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  routeId         String    @map("route_id") @db.Uuid
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  route           Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([userId, routeId])
  @@map("user_route_progress")
}

model PoiVisits {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  poiId           String    @map("poi_id") @db.Uuid
  entryTime       DateTime  @map("entry_time")
  exitTime        DateTime? @map("exit_time")
  durationSeconds Int?      @map("duration_seconds")
  rating          Int?      @default(0)
  
  poi             Poi       @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@map("poi_visits")
}

model UserTelemetry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  
  // Camp PostGIS Natiu (Point, 4326)
  location  Unsupported("geometry(Point, 4326)")
  
  timestamp DateTime @default(now())
  
  user      User?    @relation(fields: [userId], references: [id])

  @@index([location], type: Gist)
  @@map("user_telemetry")
}

model Report {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId String       @map("municipality_id") @db.Uuid
  title          String
  status         ReportStatus @default(PENDING)
  resultUrl      String?      @map("result_url")
  data           Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model AiUsageLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @default("generate_route")
  tokens    Int?
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_usage_logs")
}

// --- ENUMS ---

enum UserRole {
  tourist
  municipal_admin
  super_admin
}

enum ThemeId {
  mountain
  coast
  city
  interior
  bloom
}

enum RouteStatus {
  DRAFT
  CLOSED
}

enum RouteAvailability {
  permanent
  temporal
  event
}

enum PoiType {
  RELIGIOS
  DEFENSIU
  CIVIL
  NATURA
  AIGUA
  MIRADOR
  LLEGENDA
  PERSONA_ILLUSTRE
  GUERRA_CIVIL
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model OutboxEvent {

  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic           String    @map("tipus_event")
  payload         Json
  status          String    @default("PENDING") @map("estat")
  createdAt       DateTime  @default(now()) @map("creat_el")

  @@map("outbox_events")
}

