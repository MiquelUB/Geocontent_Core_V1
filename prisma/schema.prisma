generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, postgis_tiger_geocoder, postgis_topology, uuid_ossp(map: "uuid-ossp")]
}

model User {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String              @unique
  emailVerified  DateTime?           @map("email_verified")
  passwordHash   String?             @map("password_hash")
  username       String?
  image          String?
  avatarUrl      String?             @map("avatar_url")
  role           UserRole            @default(TOURIST)
  xp             Int                 @default(0)
  level          Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  municipalityId String?             @map("municipality_id") @db.Uuid
  emailConsent    Boolean?            @default(true) @map("email_consent")
  termsAcceptedAt DateTime?           @map("terms_accepted_at")
  lastLoginAt     DateTime?           @map("last_login_at")
  accounts       Account[]
  sessions       Session[]
  routeProgress  UserRouteProgress[]
  telemetry      UserTelemetry[]
  unlocks        UserUnlock[]
  municipality   Municipality?       @relation(fields: [municipalityId], references: [id])

  @@index([municipalityId])
  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Municipality {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  slug                String    @unique
  nameTranslations    Json      @default("{}") @map("name_translations")
  logoUrl             String?   @map("logo_url")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  planTier            String    @default("basic") @map("plan_tier")
  themeId             String?   @default("mountain") @map("theme_id")
  adminMasterPassword String?   @map("admin_master_password")
  lastPublishedAt     DateTime? @map("last_published_at")
  packagingStatus     String    @default("IDLE") @map("packaging_status")
  voicePersona        String?   @default("Persona gran, veu càlida, serena i amb experiència patrimonial") @map("voice_persona")
  reports             Report[]
  routes              Route[]
  users               User[]

  @@map("municipalities")
}

model Route {
  id                      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId          String?             @map("municipality_id") @db.Uuid
  slug                    String              @unique
  name                    String?
  nameTranslations        Json                @default("{}") @map("name_translations")
  description             String?
  descriptionTranslations Json                @default("{}") @map("description_translations")
  themeId                 ThemeId             @default(mountain) @map("theme_id")
  availabilityType        RouteAvailability   @default(permanent) @map("availability_type")
  isPremium               Boolean             @default(false) @map("is_premium")
  thumbnail1x1            String?             @map("thumbnail_1x1")
  header16x9              String?             @map("header_16x9")
  status                  RouteStatus         @default(DRAFT)
  finalQuiz               Json?               @map("final_quiz")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @default(now()) @updatedAt @map("updated_at")
  audioTranslations       Json                @default("{}") @map("audio_translations")
  routePois               RoutePoi[]
  municipality            Municipality?       @relation(fields: [municipalityId], references: [id])
  userProgress            UserRouteProgress[]

  @@index([municipalityId])
  @@map("routes")
}

model Poi {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                     String
  description               String?
  titleTranslations         Json                     @default("{}") @map("title_translations")
  descriptionTranslations   Json                     @default("{}") @map("description_translations")
  location                  Unsupported("geometry")?
  latitude                  Float?
  longitude                 Float?
  audioUrl                  String?                  @map("audio_url")
  videoUrls                 String[]                 @default([]) @map("video_urls")
  textContent               String?                  @map("text_content")
  appThumbnail              String?                  @map("app_thumbnail")
  header16x9                String?                  @map("header_16x9")
  carouselImages            String[]                 @default([]) @map("carousel_images")
  carouselCaptions          Json?                    @default("[]") @map("carousel_captions")
  icon                      String?
  type                      PoiType?
  manualQuiz                Json?                    @map("manual_quiz")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @default(now()) @updatedAt @map("updated_at")
  textContentTranslations Json                     @default("{}") @map("text_content_translations")
  audioTranslations       Json                     @default("{}") @map("audio_translations")
  videoTranslations       Json                     @default("{}") @map("video_translations")
  voiceScript             String?                  @map("voice_script")
  voiceId                 String?                  @map("voice_id")
  visits                    PoiVisits[]
  routePois                 RoutePoi[]
  userUnlocks               UserUnlock[]

  @@index([location], type: Gist)
  @@map("pois")
}

model RoutePoi {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId    String @map("route_id") @db.Uuid
  poiId      String @map("poi_id") @db.Uuid
  orderIndex Int    @default(0) @map("order_index")
  poi        Poi    @relation(fields: [poiId], references: [id], onDelete: Cascade)
  route      Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, poiId])
  @@index([poiId])
  @@map("route_pois")
}

model UserUnlock {
  userId     String   @map("user_id") @db.Uuid
  poiId      String   @map("poi_id") @db.Uuid
  unlockedAt DateTime @default(now()) @map("unlocked_at")
  earnedXp   Int      @map("earned_xp")
  quizSolved Boolean  @default(false) @map("quiz_solved")
  poi        Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, poiId])
  @@index([poiId])
  @@map("user_unlocks")
}

model UserRouteProgress {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  routeId     String    @map("route_id") @db.Uuid
  completedAt DateTime? @map("completed_at")
  rating      Int?      @default(0)
  comment     String?
  createdAt   DateTime  @default(now()) @map("created_at")
  route       Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, routeId])
  @@index([routeId])
  @@map("user_route_progress")
}

model PoiVisits {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  poiId           String    @map("poi_id") @db.Uuid
  entryTime       DateTime  @map("entry_time")
  exitTime        DateTime? @map("exit_time")
  durationSeconds Int?      @map("duration_seconds")
  rating          Int?      @default(0)
  poi             Poi       @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@index([poiId])
  @@index([userId])
  @@map("poi_visits")
}

model UserTelemetry {
  id        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?                 @map("user_id") @db.Uuid
  location  Unsupported("geometry")
  timestamp DateTime                @default(now())
  user      User?                   @relation(fields: [userId], references: [id])

  @@index([location], type: Gist)
  @@index([userId])
  @@map("user_telemetry")
}

model Report {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  municipalityId String       @map("municipality_id") @db.Uuid
  title          String
  status         ReportStatus @default(PENDING)
  resultUrl      String?      @map("result_url")
  data           Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@index([municipalityId])
  @@map("reports")
}

model AiUsageLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @default("generate_route")
  tokens    Int?
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("ai_usage_logs")
}

model OutboxEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic     String   @map("tipus_event")
  payload   Json
  status    String   @default("PENDING") @map("estat")
  createdAt DateTime @default(now()) @map("creat_el")

  @@map("outbox_events")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum UserRole {
  TOURIST
  ADMIN
  SUPER_ADMIN
}

enum ThemeId {
  mountain
  coast
  city
  interior
  bloom
}

enum RouteStatus {
  DRAFT
  CLOSED
}

enum RouteAvailability {
  permanent
  temporal
  event
}

enum PoiType {
  RELIGIOS
  DEFENSIU
  CIVIL
  NATURA
  AIGUA
  MIRADOR
  LLEGENDA
  PERSONA_ILLUSTRE
  GUERRA_CIVIL
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model AdminAuditLog {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId          String   @map("admin_user_id") @db.Uuid
  action               String   // "impersonate" | "create_municipality" | "delete_user" | etc.
  targetMunicipalityId String?  @map("target_municipality_id") @db.Uuid
  targetUserId         String?  @map("target_user_id") @db.Uuid
  metadata             Json?    // Informació addicional (IP, User-Agent, etc.)
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("admin_audit_logs")
  @@index([adminUserId])
  @@index([createdAt])
}

model AlembicVersion {
  version_num String @id @db.VarChar(32)

  @@map("alembic_version")
}

